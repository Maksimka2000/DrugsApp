<Project Sdk="Microsoft.NET.Sdk.Web">



  <PropertyGroup>
    <UserSecretsId>c15afcde-76ac-47d8-99d2-7f5d5cc2f749</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerComposeProjectPath>..\docker-compose.dcproj</DockerComposeProjectPath>
    <RunPatientDevSeed Condition="'$(RunPatientDevSeed)' == ''">true</RunPatientDevSeed>
  </PropertyGroup>



  <ItemGroup>
      <!-- <PackageReference Include="Microsoft.AspNetCore.OpenApi" />  -->
    <PackageReference Include="Hangfire.AspNetCore" />
    <PackageReference Include="Hangfire.PostgreSql" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Seq" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

    
    
  <ItemGroup>
    <ProjectReference Include="..\DrugsApp.Features\DrugsApp.Features.csproj" />
    <ProjectReference Include="..\DrugsApp.Infrastructure\DrugsApp.Infrastructure.csproj" />
  </ItemGroup>

  <Target
    Name="ApplyPatientDevSeed"
    AfterTargets="Build"
    Condition="'$(Configuration)' == 'Debug' AND '$(RunPatientDevSeed)' == 'true' AND '$(DesignTimeBuild)' != 'true'">
    <Message Importance="high" Text="Applying patient dev seed (skip with RunPatientDevSeed=false)..." />
    <Exec
      Command="dotnet run --project &quot;$(MSBuildProjectDirectory)/../DrugsApp.DevSeed/DrugsApp.DevSeed.csproj&quot; --configuration $(Configuration) --verbosity quiet"
      IgnoreExitCode="true" />
  </Target>

</Project>
