{
  "AllowedHosts": "*",
  "Auth": {
    "Jwt": {
      "Issuer": "DrugsApp",
      "Audience": "DrugsApp.Client",
      "AccessTokenMinutes": 60,
      "RefreshTokenDays": 7
    }
  },
  "Notifications": {
    "WeeklyHealthDataReminder": {
      "Enabled": true,
      "CronExpression": "0 8 * * 1"
    }
  },
  "RegularDrugs": {
    "ExpirationJob": {
      "Enabled": true,
      "CronExpression": "59 2 * * *"
    }
  },
  "RegularFood": {
    "ExpirationJob": {
      "Enabled": true,
      "CronExpression": "59 2 * * *"
    }
  },
  "RegularSupplements": {
    "ExpirationJob": {
      "Enabled": true,
      "CronExpression": "59 2 * * *"
    }
  },
  "Hangfire": {
    "DashboardPath": "/hangfire",
    "EnableDashboard": true,
    "WorkerCount": 3,
    "SchedulePollingIntervalSeconds": 30,
    "QueuePollIntervalSeconds": 30,
    "RetryAttempts": 1,
    "Queues": [ "notifications", "regular-intakes", "imports", "default" ]
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}
