  "Email": {
    "SenderEmail": "no-reply@drugsapp.local",
    "SenderName": "DrugsApp",
    "SmtpHost": "localhost",
    "SmtpPort": 2525,
    "ClientBaseUrl": "http://localhost:3000"
  },
  "Notifications": {
    "WeeklyHealthDataReminder": {
      "Enabled": true,
      "CronExpression": "0 8 * * 1"
    }
  },
  "RegularDrugs": {
    "ExpirationJob": {
      "Enabled": true,
      "CronExpression": "59 2 * * *"
    }
  },
  "RegularFood": {
    "ExpirationJob": {
      "Enabled": true,
      "CronExpression": "59 2 * * *"
    }
  },
  "RegularSupplements": {
    "ExpirationJob": {
      "Enabled": true,
      "CronExpression": "59 2 * * *"
    }
  },
  "Hangfire": {
    "DashboardPath": "/hangfire",
    "EnableDashboard": true,
    "WorkerCount": 2,
    "SchedulePollingIntervalSeconds": 30,
    "QueuePollIntervalSeconds": 30,
    "RetryAttempts": 1,
    "Queues": [ "notifications", "regular-intakes", "imports", "default" ]
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { 
        "Name": "Seq",
        "Args": { "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}

